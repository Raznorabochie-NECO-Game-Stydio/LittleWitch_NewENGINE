label coridor_06:
    #Коридор

    e "Девочка пробовала открывать двери по очереди, авось какая из них и отворится. "

    menu:
        "Куда пойти?"
        "Обратно, на лестничную площадку":
            jump lest6
        "В первую дверь":
            jump door_022
        "Во вторую дверь":
            jump door_023
        "В третью дверь":
            jump door_024
        "В четвёртую дверь":
            jump door_025
        "В пятую дверь":
            jump door_026
        "В шестую дверь":
            jump door_027


    return

label door_022:

    if Room_22 == False:

        $ Room_22 = True

        e "Маленькая ведьма прикоснулась к холодному металлу ручки."

        e "Дверь оказалась заперта."

        LW "{i}- Может... мне стоит попробовать другую дверь?{/i}"

        jump hallway_06
        pass

    else:
        $ replica = renpy.random.choice([1, 2, 3])

        if replica == 1:

            LW "{i} - Здесь я уже была…{/i}"
            LW "{i} - И почему я снова зашла!?.{/i}"
            LW "{i} - Может… Стоит попробовать другую дверь…{/i}"


            pass
        elif replica == 2:

            LW "{i} - Я снова вошла не в ту дверь… {/i}"
            LW "{i} - Может… Стоит попробовать другую дверь…{/i}"

            pass
        elif replica == 3:

            LW "- В жизни любого бывает момент когда заходишь не туда…"
            LW "{i} - Может… Стоит попробовать другую дверь…{/i}"

            pass
        
        jump hallway_06

    return

