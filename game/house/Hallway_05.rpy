label door_016:

    if Room_16 == False:

        $ Room_16 = True

        e "Маленькая ведьма прикоснулась к холодному металлу ручки."

        e "Дверь оказалась заперта."

        LW "{i}- Может... мне стоит попробовать другую дверь?{/i}"

        jump coridor_05
        pass

    else:
        $ replica = renpy.random.choice([1, 2, 3])

